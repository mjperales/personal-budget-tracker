{
  "name": "personal-budget-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @budget-tracker/api dev & pnpm --filter @budget-tracker/web dev",
    "build": "pnpm --filter './apps/*' --filter './packages/*' run build",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "typecheck": "pnpm --filter './apps/*' --filter './packages/*' run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "@vitest/coverage-v8": "^3.0.5",
    "concurrently": "^9.1.2",
    "eslint": "^9.18.0",
    "globals": "^17.11.0",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  },
  "packageManager": "pnpm@9.15.4"
}
